  <text x="30" y="27">Warmup</text><text x="133" y="27">Restarting</text><text class="on-hot" x="136" y="89">Ongoing</text><text x="31" y="89">Ending</text>
  <g class="ink" stroke-width="1" marker-end="url(#phase-arrow)">
