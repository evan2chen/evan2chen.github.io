---
import type { Figure } from '../data/site';

interface Props {
  figure: Figure;
}

const { figure } = Astro.props;
---

<figure class="plate" id={`fig-${figure.number}`}>
  <div class="frame"><slot /></div>
  <figcaption>
    <b>Fig. {figure.number}</b>{' '}<strong>{figure.title}.</strong>{' '}{figure.caption}{figure.note && <>{' '}<span class="note">{figure.note}</span></>}
    <span class="meta label">
      {figure.stack}
      {figure.action.href ? <a href={figure.action.href}>{figure.action.label}</a> : <mark class="draft" data-draft>{figure.action.label}</mark>}
    </span>
  </figcaption>
</figure>

<style>
  .plate {
    margin: 0;
  }

  .frame {
    background: var(--plate);
    border: 1px solid var(--rule);
    padding: 10px;
  }

  .frame :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .frame :global(text) {
    font-family: var(--sans);
    font-size: 9.6px;
    fill: var(--ink-2);
  }

  .frame :global(.ink) {
    stroke: var(--ink);
    fill: none;
  }

  .frame :global(.box) {
    stroke: var(--ink);
    fill: var(--plate);
  }

  .frame :global(.f1) { fill: var(--r1); }
  .frame :global(.q1),
  .frame :global(.q2) {
    stroke: var(--quiet-line);
    stroke-width: 0.8;
  }

  .frame :global(.q1) { fill: var(--quiet); }
  .frame :global(.q2) { fill: var(--quiet-2); }

  .frame :global(.hot) {
    fill: var(--mark);
    transition: fill 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .frame :global(.hot-line) {
    stroke: var(--ink);
    transition: stroke 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .plate:hover .frame :global(.hot),
  .plate:focus-within .frame :global(.hot) {
    fill: var(--hot);
  }

  .plate:hover .frame :global(.hot-line),
  .plate:focus-within .frame :global(.hot-line) {
    stroke: var(--hot);
  }

  .frame :global(.on-hot) {
    fill: var(--on-mark);
    font-weight: 700;
  }

  .frame :global(.strong) {
    fill: var(--ink);
    font-weight: 700;
  }

  figcaption {
    margin-top: 10px;
    font-size: 16px;
    line-height: 1.5;
  }

  figcaption b {
    font: 700 16px var(--sans);
    font-stretch: 112%;
    margin-right: 2px;
  }

  figcaption strong {
    font-weight: 700;
  }

  .note {
    color: var(--ink-2);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin-top: 6px;
  }

  .meta a,
  .meta mark {
    color: var(--ink);
    font-weight: 600;
  }
</style>
