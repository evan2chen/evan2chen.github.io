---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import { edit, entryLabels, isoDate, monthYear, site, type EntryType } from '../../lib/content';

const entries = (await getCollection('other')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const filters: ['all' | EntryType, string][] = [
  ['all', 'All'],
  ['post', 'Posts'],
  ['image', 'Images'],
  ['project', 'Projects'],
];
const count = (type: 'all' | EntryType) => (type === 'all' ? entries.length : entries.filter((e) => e.data.type === type).length);
const action = (type: EntryType, images: number) => (type === 'post' ? 'Read' : type === 'image' ? `${images} photo${images === 1 ? '' : 's'}` : 'View');
---

<Base page="other" title={`Other - ${site.name}`}>
  <main id="main" class="wrap">
    <h1 class="display">Other</h1>
    <hr class="rule" />
    <div class="feed-wrap" {...edit('add', 'other', { types: 'post,image,project' })}>
      {
        entries.length ? (
          <>
            <div class="filters" role="group" aria-label="Filter entries" hidden>
              {filters.map(([type, label]) => (
                <button type="button" data-filter={type} aria-pressed={String(type === 'all')}>
                  {label}
                  <i>{count(type)}</i>
                </button>
              ))}
            </div>
            <ol class="feed">
              {entries.map((entry) => {
                const { title, date, type, excerpt, images } = entry.data;
                const href = `/other/${entry.id}/`;
                return (
                  <li class="grid" data-type={type} {...edit('item', `other:${entry.id}`)}>
                    <time class="date muted" datetime={isoDate(date)}>{monthYear(date)}</time>
                    <span class="type muted">{entryLabels[type]}</span>
                    <div class="body">
                      <h2><a href={href}>{title}</a></h2>
                      {type === 'image' ? (
                        <div class="thumbs">
                          {images.slice(0, 3).map((img) => <img src={img.src} alt={img.alt} loading="lazy" decoding="async" />)}
                        </div>
                      ) : type === 'project' && images[0] ? (
                        <div class="project">
                          {excerpt && <p>{excerpt}</p>}
                          <img src={images[0].src} alt={images[0].alt} loading="lazy" decoding="async" />
                        </div>
                      ) : (
                        excerpt && <p>{excerpt}</p>
                      )}
                    </div>
                    <a class="go" href={href} aria-label={`${action(type, images.length)}: ${title}`}>
                      {action(type, images.length)} →
                    </a>
                  </li>
                );
              })}
            </ol>
          </>
        ) : (
          <p class="empty muted" {...edit('text', 'site:otherEmpty')}>{site.otherEmpty}</p>
        )
      }
    </div>
  </main>
  <Footer />
</Base>

<script>
  const group = document.querySelector<HTMLElement>('.filters');
  if (group) {
    group.hidden = false;
    const buttons = [...group.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...document.querySelectorAll<HTMLElement>('.feed > li')];
    for (const button of buttons) {
      button.addEventListener('click', () => {
        const type = button.dataset.filter!;
        for (const b of buttons) b.setAttribute('aria-pressed', String(b === button));
        for (const item of items) item.hidden = type !== 'all' && item.dataset.type !== type;
      });
    }
  }
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    padding: 14px 0 18px;
  }

  .filters[hidden] {
    display: none;
  }

  .filters button {
    font: 500 calc(var(--t) * 1.07) var(--font);
    background: none;
    border: 0;
    color: var(--ink-2);
    padding: 2px 0;
    min-height: 28px;
    cursor: pointer;
  }

  .filters button i {
    font-style: normal;
    font-size: 12px;
    margin-left: 5px;
  }

  .filters button[aria-pressed='true'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--acc);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .feed {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1.5px solid var(--rule);
  }

  .feed > li {
    padding: 22px 0;
    border-bottom: 1px solid var(--hair);
  }

  .feed > li[hidden] {
    display: none;
  }

  .feed {
    font-size: var(--t);
  }

  .date {
    grid-column: 1 / 3;
  }

  .type {
    grid-column: 3 / 4;
  }

  .body {
    grid-column: 4 / 11;
    min-width: 0;
  }

  h2 {
    font-weight: 600;
    font-size: 26px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 8px;
  }

  .body p {
    margin: 0;
    font-size: calc(var(--t) * 1.07);
    max-width: 52ch;
  }

  .go {
    grid-column: 11 / 13;
    text-align: right;
  }

  .thumbs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin-top: 12px;
  }

  .thumbs img,
  .project img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--wash);
  }

  .project {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 180px;
    gap: var(--gap);
    align-items: start;
  }

  .empty {
    padding-top: 18px;
    font-size: 18px;
  }

  @media (max-width: 720px) {
    .date {
      grid-column: 1 / 7;
    }

    .type {
      grid-column: 7 / 13;
      text-align: right;
    }

    .body,
    .go {
      grid-column: 1 / 13;
      text-align: left;
    }

    .project {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
