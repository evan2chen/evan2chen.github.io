---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found - Evan Chen">
  <main id="main" class="wrap missing">
    <p class="label">Error 404</p>
    <h1>This page isn't in the histogram.</h1>
    <p>The address may be mistyped, or the page may have moved.</p>
    <p><a class="home" href="/">Back to the home page</a></p>
  </main>
</Base>

<style>
  .missing {
    padding-top: clamp(64px, 14vw, 160px);
    padding-bottom: 96px;
  }

  h1 {
    font-weight: 800;
    font-stretch: 112%;
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 8px 0 20px;
    max-width: 14em;
  }

  .home {
    font: 700 16px var(--sans);
  }
</style>
