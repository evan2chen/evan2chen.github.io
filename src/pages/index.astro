---
import Base from '../layouts/Base.astro';
import Heatmap from '../components/Heatmap.astro';
import { edit, site } from '../lib/content';
---

<Base page="home" fill>
  <main id="main" class="home grid">
    <div class="side">
      <h1 class="name" {...edit('text', 'site:name')}>{site.name}</h1>
      <div class="about">
        <figure class="photo" {...edit('media', 'site:photo', { accept: 'image/*' })}>
          {
            site.photo.src ? (
              <img src={site.photo.src} alt={site.photo.alt} width="568" height="757" decoding="async" />
            ) : (
              <div class="placeholder muted">Photo coming soon</div>
            )
          }
        </figure>
        <div class="text">
          <p class="statement" {...edit('text', 'site:description', { raw: site.description })}>
            {site.description || <span class="draft">One sentence in your own voice about what you build and why.</span>}
          </p>
          <dl class="facts">
            <dt>Study</dt>
            <dd {...edit('text', 'site:study')}>{site.study}</dd>
          </dl>
        </div>
      </div>
      <div class="list links">
        <a class="solid" href="/resume.pdf">Resume (PDF)<span aria-hidden="true">↓</span></a>
        <a href={`mailto:${site.email}`} {...edit('href', 'site:email')}>{site.email}<span aria-hidden="true">→</span></a>
        <a href={site.github} {...edit('href', 'site:github')}>GitHub<span aria-hidden="true">→</span></a>
        <a href={site.linkedin} {...edit('href', 'site:linkedin')}>LinkedIn<span aria-hidden="true">→</span></a>
      </div>
    </div>
    <Heatmap />
  </main>
</Base>

<style>
  .home {
    --t: 17px;
    --t-small: 14px;
    --t-statement: 25px;
    padding: 0 var(--edge) min(var(--edge), 12vh);
    min-height: 0;
    font-size: var(--t);
  }

  .side {
    grid-column: 1 / 5;
    display: flex;
    flex-direction: column;
    gap: calc(var(--gutter) * 0.7);
    padding-top: calc(var(--gutter) * 0.2);
    min-width: 0;
  }

  .name {
    font-weight: 600;
    font-size: clamp(64px, 10vw, 176px);
    line-height: 0.86;
    letter-spacing: -0.055em;
    margin: 0 0 0 -0.045em;
    max-width: 4.6em;
  }

  .about {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--gap);
    align-items: end;
    margin-top: auto;
  }

  .photo {
    margin: 0;
  }

  .photo img,
  .placeholder {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    background: var(--wash);
  }

  .placeholder {
    display: grid;
    place-items: center;
    font-size: var(--t-small);
  }

  .text {
    display: grid;
    gap: calc(var(--gutter) * 0.5);
  }

  .statement {
    font-size: var(--t-statement);
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .facts {
    grid-template-columns: minmax(0, 1fr);
    font-size: inherit;
  }

  .facts dt {
    padding-bottom: 0;
  }

  .facts dd {
    border-top: 0;
    padding-top: 2px;
  }

  .links {
    font-size: inherit;
  }

  .home :global(.heatmap) {
    grid-column: 5 / 13;
    margin-left: var(--gap);
  }

  .home :global(.heatmap .legend) {
    padding-bottom: 0;
  }

  @media (max-width: 900px) {
    .home {
      display: flex;
      flex-direction: column;
    }

    .side {
      display: contents;
    }

    .name {
      padding: 8px 0 20px;
    }

    .home :global(.heatmap) {
      order: 1;
      padding-top: 80vw;
      margin: 0;
    }

    .home :global(.heatmap .legend) {
      position: static;
      padding: 12px 0 0;
    }

    .home :global(.heatmap .field) {
      bottom: auto;
      height: 80vw;
    }

    .about,
    .links {
      order: 2;
      margin-top: 24px;
    }

    .about {
      grid-template-columns: minmax(0, 1fr);
    }

    .photo {
      width: min(46vw, 240px);
    }
  }
</style>
